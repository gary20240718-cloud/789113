local lastUpdate = 0
RunService.RenderStepped:Connect(function()
    if FlyControl.Visible ~= Config.FlyEnabled then FlyControl.Visible = Config.FlyEnabled end
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local myHum = char and char:FindFirstChildOfClass("Humanoid")

    if isFlying and bodyVelocity and myRoot and myHum then
        if Config.FlyNoclip then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
        local moveDir = Vector3.new(0, 0, 0)
        local playerModule = LocalPlayer:FindFirstChild("PlayerScripts"):FindFirstChild("PlayerModule")
        if playerModule then
            local controls = require(playerModule):GetControls()
            local moveVector = controls:GetMoveVector()
            if moveVector.Magnitude > 0 then moveDir = (Camera.CFrame.LookVector * -moveVector.Z) + (Camera.CFrame.RightVector * moveVector.X) end
        end
        if flyUp then moveDir += Vector3.new(0, 1, 0) end
        if flyDown then moveDir -= Vector3.new(0, 1, 0) end
        if moveDir.Magnitude > 0 then bodyVelocity.Velocity = moveDir.Unit * flySpeed else bodyVelocity.Velocity = Vector3.new(0, 0, 0) end
    end

    if Config.TPEnabled and myRoot and myHum then
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
        local closestPlayer, closestDist = nil, MaxDistance
        for _, player in ipairs(Players:GetPlayers()) do
            if not isTeammate(player) and player.Character then
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local hum = player.Character:FindFirstChildOfClass("Humanoid")
                if root and hum and hum.Health > 0 then
                    local dist = (myRoot.Position - root.Position).Magnitude
                    if dist < closestDist then closestDist = dist; closestPlayer = player end
                end
            end
        end
        if closestPlayer and closestPlayer.Character and closestPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local enemyRoot = closestPlayer.Character.HumanoidRootPart
            local enemyLook = enemyRoot.CFrame.LookVector
            local targetPos
            if Config.TP_Distance == 10 then targetPos = enemyRoot.Position + Vector3.new(0, 6.5, 0) 
            elseif Config.TP_Distance == 5 then targetPos = enemyRoot.Position + Vector3.new(0, 3.5, 0)
            else targetPos = enemyRoot.Position + (enemyLook * Config.TP_Distance) end
            myRoot.CFrame = CFrame.new(targetPos, enemyRoot.Position) 
        end
    end

    if not Config.Enabled then
        for plr, _ in pairs(ESP_Objects) do 
            if ESP_Objects[plr].billboard then ESP_Objects[plr].billboard:Destroy() end
        end
        ESP_Objects = {}
        for _, line in pairs(TracerLines) do line.Visible = false end
        return
    end

    local tick = tick()
    if tick - lastUpdate < 0.05 then return end
    lastUpdate = tick

    local validEnemies = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if not isTeammate(player) and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and root and humanoid and humanoid.Health > 0 and myRoot then
                local dist = (myRoot.Position - root.Position).Magnitude
                if dist > MaxDistance then
                    if ESP_Objects[player] then ESP_Objects[player].billboard:Destroy(); ESP_Objects[player] = nil end
                else
                    forceCreateESP(player)
                    local ui = ESP_Objects[player]
                    if ui and ui.billboard and ui.billboard.Parent then
                        ui.nameLabel.Visible = Config.Name or Config.Distance
                        if Config.Name and Config.Distance then ui.nameLabel.Text = player.Name .. " [" .. math.floor(dist) .. "m]"
                        elseif Config.Name then ui.nameLabel.Text = player.Name
                        elseif Config.Distance then ui.nameLabel.Text = "[" .. math.floor(dist) .. "m]" end
                        
                        ui.healthText.Visible = Config.HealthText
                        ui.healthText.Text = math.floor(humanoid.Health) .. " HP"
                        
                        ui.healthBg.Visible = Config.HealthBar
                        if Config.HealthBar then
                            local ratio = humanoid.Health / humanoid.MaxHealth
                            ui.healthBar.Size = UDim2.new(1, 0, ratio, 0)
                            ui.healthBar.BackgroundColor3 = (ratio < 0.3) and Color3.fromRGB(255, 0, 0) or Color3.fromRGB(0, 255, 0)
                        end
                    end
                    
                    if Config.Chams then
                        if not Chams_Objects[player] or not Chams_Objects[player].Highlight.Parent then
                            if Chams_Objects[player] and Chams_Objects[player].Highlight then Chams_Objects[player].Highlight:Destroy() end
                            local h = Instance.new("Highlight")
                            h.FillColor = Color3.fromRGB(255, 50, 50)
                            h.FillTransparency = 0.5
                            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            h.Adornee = player.Character
                            h.Parent = player.Character
                            Chams_Objects[player] = {Highlight = h}
                        end
                    end
                    
                    table.insert(validEnemies, {player = player, dist = dist, head = head})
                end
            end
        end
    end

    if Config.TracerEnabled then
        table.sort(validEnemies, function(a, b) return a.dist < b.dist end)
        local screenX = Camera.ViewportSize.X / 2
        local screenY = 0
        
        for i = 1, MaxTracers do
            local line = TracerLines[i]
            if validEnemies[i] then
                local screenPos, onScreen = Camera:WorldToViewportPoint(validEnemies[i].head.Position)
                line.From = Vector2.new(screenX, screenY)
                line.To = Vector2.new(screenPos.X, screenPos.Y)
                line.Visible = onScreen
            else
                line.Visible = false
            end
        end
    else
        for _, line in pairs(TracerLines) do line.Visible = false end
    end
end)
